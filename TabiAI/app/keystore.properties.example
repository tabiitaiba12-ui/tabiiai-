# Copy this file to "keystore.properties" (same folder) and fill in real values.
# keystore.properties is git-ignored and must NEVER be committed.
#
# Generate a keystore first (see README.md "Building a signed release APK"), e.g.:
#   keytool -genkeypair -v -keystore my-release-key.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias tabi-key
#
# storeFile is resolved relative to the app/ module folder, so if the .jks
# lives at the project root, use "../my-release-key.jks".

storeFile=../my-release-key.jks
storePassword=CHANGE_ME
keyAlias=tabi-key
keyPassword=CHANGE_ME
